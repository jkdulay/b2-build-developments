---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from '@lucide/astro';
import { projects, projectCategories } from '../data/projects';

const allFilters = ['ALL PROJECTS', ...projectCategories];
---

<Layout
  title="Portfolio — B2 Build Ltd | Custom Homes & Renovations Calgary"
  description="Browse B2 Build Ltd's portfolio of luxury custom homes, infill properties, and home renovations in Calgary's inner-city neighbourhoods."
>
  <Header />

  <!-- PAGE HERO -->
  <section class="relative h-64 lg:h-80 bg-black flex items-end overflow-hidden">
    <img
      src="/photos/butler/butler-1.jpg"
      alt="B2 Build portfolio"
      class="absolute inset-0 w-full h-full object-cover opacity-40"
    />
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-12 w-full">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3">OUR WORK</p>
      <h1 class="font-display text-3xl lg:text-5xl text-white">
        PORTFOLIO
      </h1>
    </div>
  </section>

  <!-- FILTER NAV + GALLERY -->
  <section class="py-16 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <!-- Filter Nav -->
      <div class="flex flex-wrap gap-3 mb-12">
        {allFilters.map((filter) => (
          <button
            data-filter={filter}
            class="portfolio-filter text-xs tracking-[0.2em] uppercase px-5 py-2.5 border border-black/20 text-black hover:bg-black hover:text-white transition-all duration-300 active:bg-black active:text-white"
          >
            {filter}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div id="portfolio-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="portfolio-item group overflow-hidden bg-white block"
            data-category={project.category}
          >
            <div class="relative h-64 overflow-hidden">
              <img
                src={project.cardPhoto.src}
                alt={project.cardPhoto.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              {project.badge && (
                <div class="absolute top-4 left-4 bg-gold text-white text-xs font-body font-medium tracking-[0.15em] uppercase px-4 py-2">
                  {project.badge}
                </div>
              )}
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-all duration-300 flex items-center justify-center">
                <span class="text-white text-xs tracking-[0.2em] uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300 border border-white px-4 py-2">
                  VIEW PROJECT
                </span>
              </div>
            </div>
            <div class="p-6">
              <p class="text-gold text-xs tracking-[0.2em] uppercase mb-1">{project.category}</p>
              <h3 class="font-display text-xl text-black mb-1">{project.name}</h3>
              <p class="text-black/70 text-xs">{project.location} &nbsp;&bull;&nbsp; {project.year}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="bg-black py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-4">NEXT PROJECT</p>
      <h2 class="font-display text-3xl lg:text-4xl text-white mb-4">
        Let's Build Your Next Home
      </h2>
      <p class="text-white/60 text-sm mb-10 max-w-lg mx-auto">
        From concept sketches to final keys — your dream home is waiting.
      </p>
      <a href="#contact" class="btn-gold">
        START YOUR PROJECT <ArrowRight class="w-4 h-4 ml-2" />
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.portfolio-filter');
  const items = document.querySelectorAll<HTMLElement>('.portfolio-item');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      // Update active state
      filters.forEach((b) => b.classList.remove('bg-black', 'text-white'));
      btn.classList.add('bg-black', 'text-white');

      // Show/hide items
      items.forEach((item) => {
        if (filter === 'ALL PROJECTS' || item.dataset.category === filter) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Set initial active
  filters[0]?.classList.add('bg-black', 'text-white');
</script>
