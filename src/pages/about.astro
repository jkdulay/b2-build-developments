---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Hammer, Palette, Users, ShieldCheck } from '@lucide/astro';
---

<Layout
  title="About — B2 Build Ltd | Your Vision, Our Mission"
  description="Learn about B2 Build Ltd — Calgary's premier custom home builder focused on luxury inner-city living."
>
  <Header />

  <!-- PAGE HERO -->
  <section class="relative h-64 lg:h-80 bg-navy flex items-end overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1600&q=85"
      alt="Luxury living room"
      class="absolute inset-0 w-full h-full object-cover opacity-30"
    />
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-12 w-full">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3">ABOUT</p>
      <h1 class="font-display text-3xl lg:text-5xl text-white">
        ABOUT B2 BUILD LTD
      </h1>
      <p class="text-gold text-sm tracking-[0.3em] uppercase mt-2">YOUR VISION, OUR MISSION.</p>
    </div>
  </section>

  <!-- TWO COLUMN TEXT + HERO IMAGE -->
  <section class="py-20 lg:py-28 bg-offwhite">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <!-- Hero image -->
      <div class="w-full h-64 lg:h-96 mb-16 overflow-hidden">
        <img
          src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1400&q=85"
          alt="Modern luxury home exterior"
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Two-column text -->
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <p class="text-textgray text-sm leading-relaxed mb-6">
            B2 Build Ltd is a Calgary-based custom home builder specializing in luxury inner-city residences. Founded on the principle that every home should be a masterwork of craft and design, we bring decades of construction expertise to each and every project.
          </p>
          <p class="text-textgray text-sm leading-relaxed">
            From initial concept to final walkthrough, our team works closely with homeowners to understand their vision, lifestyle, and aspirations. We believe building a home should be an exciting journey — one marked by transparent communication, meticulous attention to detail, and a shared passion for creating spaces that truly elevate everyday living.
          </p>
        </div>
        <div>
          <p class="text-textgray text-sm leading-relaxed mb-6">
            Our portfolio spans the full spectrum of inner-city living — from custom infill homes in established neighbourhoods to complete whole-home renovations that reimagine space in bold new ways. Every project reflects our unwavering commitment to quality craftsmanship and modern design principles.
          </p>
          <p class="text-textgray text-sm leading-relaxed">
            We build in Calgary's most desirable communities: Altadore, Killarney, Mount Pleasant, Marda Loop, and beyond. Our clients choose us because they want more than a house — they want a home that tells their story.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES BAR: 4 columns -->
  <section class="py-20 bg-white border-y border-navy/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <SectionHeading
        eyebrow="WHAT SETS US APART"
        title="Our Core Values"
        centered
      />
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 mt-10">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 bg-navy flex items-center justify-center">
            <Hammer class="w-7 h-7 text-gold" />
          </div>
          <h3 class="font-display text-lg text-navy mb-2">Quality Craftsmanship</h3>
          <p class="text-textgray text-xs leading-relaxed">Every detail matters. We use proven methods and premium materials that stand the test of time.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 bg-navy flex items-center justify-center">
            <Palette class="w-7 h-7 text-gold" />
          </div>
          <h3 class="font-display text-lg text-navy mb-2">Modern Design</h3>
          <p class="text-textgray text-xs leading-relaxed">Clean lines, open spaces, and thoughtful layouts that reflect how people actually live today.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 bg-navy flex items-center justify-center">
            <Users class="w-7 h-7 text-gold" />
          </div>
          <h3 class="font-display text-lg text-navy mb-2">Client Focused</h3>
          <p class="text-textgray text-xs leading-relaxed">Your vision drives everything. We listen, collaborate, and deliver on the promises we make.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 bg-navy flex items-center justify-center">
            <ShieldCheck class="w-7 h-7 text-gold" />
          </div>
          <h3 class="font-display text-lg text-navy mb-2">Built to Last</h3>
          <p class="text-textgray text-xs leading-relaxed">We build for generations. Structural integrity and long-term value are non-negotiable.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-navy">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl lg:text-4xl text-white mb-4">
        Ready to Start Your Journey?
      </h2>
      <p class="text-white/60 text-sm mb-10">
        Whether you're building from scratch or reimagining your current home, we'd love to hear your vision.
      </p>
      <a href="#contact" class="btn-gold">
        GET IN TOUCH
      </a>
    </div>
  </section>

  <Footer />
</Layout>
