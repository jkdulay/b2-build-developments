---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import { ArrowLeft, CheckCircle2 } from '@lucide/astro';
import { projects, getProjectBySlug } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const description = project.shortDescription;
---

<Layout
  title={`${project.name} — B2 Build Ltd | ${project.location}`}
  description={description}
>
  <Header />

  <!-- HERO -->
  <section class="relative h-[70vh] min-h-[480px] bg-black flex items-end overflow-hidden">
    {project.videoUrl ? (
      <video
        class="absolute inset-0 w-full h-full object-cover opacity-60"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={project.heroPhoto.src}
      >
        <source src={project.videoUrl} type="video/mp4" />
      </video>
    ) : (
      <img
        src={project.heroPhoto.src}
        alt={project.heroPhoto.alt}
        class="absolute inset-0 w-full h-full object-cover opacity-60"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-12 w-full">
      <a
        href="/portfolio"
        class="inline-flex items-center gap-2 text-white/70 hover:text-gold text-xs tracking-[0.2em] uppercase mb-6 transition-colors"
      >
        <ArrowLeft class="w-4 h-4" /> Back to Portfolio
      </a>
      <div class="flex items-center gap-3 mb-3">
        <p class="text-gold text-xs tracking-[0.4em] uppercase">{project.category}</p>
        {project.badge && (
          <span class="bg-gold text-white text-[10px] tracking-[0.2em] uppercase px-3 py-1 font-medium">
            {project.badge}
          </span>
        )}
      </div>
      <h1 class="font-display text-4xl lg:text-6xl text-white">
        {project.name.toUpperCase()}
      </h1>
      <p class="text-white/80 text-sm mt-3 uppercase tracking-[0.2em]">
        {project.location} &nbsp;|&nbsp; {project.year}
      </p>
      {project.tagline && (
        <p class="text-gold/90 text-xs mt-2 tracking-[0.3em] uppercase">
          {project.tagline}
        </p>
      )}
    </div>
  </section>

  <!-- DESCRIPTION + HIGHLIGHTS -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
        <!-- Description (8 cols) -->
        <div class="lg:col-span-8">
          <div class="w-12 h-px bg-gold mb-6"></div>
          <h2 class="font-display text-3xl lg:text-4xl text-black mb-8 tracking-wide">
            About {project.name}
          </h2>
          <div class="space-y-5 text-black/75 text-base leading-relaxed">
            {project.longDescription.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>

        <!-- Highlights (4 cols) -->
        <aside class="lg:col-span-4">
          <div class="bg-black p-8 lg:p-10">
            <p class="text-gold text-xs tracking-[0.4em] uppercase mb-5">Highlights</p>
            <ul class="space-y-4">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-3">
                  <CheckCircle2 class="w-5 h-5 text-gold shrink-0 mt-0.5" stroke-width="1.5" />
                  <span class="text-white/85 text-sm leading-relaxed">{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  {project.gallery.length > 0 && (
    <section class="py-16 lg:py-20 bg-white border-t border-black/10">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3">Project Gallery</p>
        <h2 class="font-display text-3xl lg:text-4xl text-black mb-10 tracking-wide">
          Inside {project.name}
        </h2>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {project.gallery.map((photo, i) => (
            <figure class="overflow-hidden bg-black/5 group">
              <button
                type="button"
                class="block w-full text-left aspect-[4/3] overflow-hidden cursor-pointer focus:outline-none focus:ring-2 focus:ring-gold"
                aria-label={`Open image ${i + 1}: ${photo.alt}`}
                onclick={`document.getElementById('gallery-lb').openLightbox(${i})`}
              >
                <img
                  src={photo.src}
                  alt={photo.alt}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              </button>
              {photo.caption && (
                <figcaption class="text-black/60 text-xs tracking-[0.15em] uppercase mt-3 px-1">
                  {photo.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <Lightbox id="gallery-lb" photos={project.gallery} />

  <!-- PROJECT INFO -->
  <section class="py-16 bg-white border-t border-black/10">
    <div class="max-w-5xl mx-auto px-6 lg:px-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 border-l-4 border-gold">
          <p class="text-xs tracking-[0.2em] uppercase text-black/70 mb-1">Project</p>
          <p class="font-display text-xl text-black">{project.name}</p>
        </div>
        <div class="bg-white p-6 border-l-4 border-gold">
          <p class="text-xs tracking-[0.2em] uppercase text-black/70 mb-1">Location</p>
          <p class="font-display text-xl text-black">{project.location.split(',')[0]}</p>
        </div>
        <div class="bg-white p-6 border-l-4 border-gold">
          <p class="text-xs tracking-[0.2em] uppercase text-black/70 mb-1">Year</p>
          <p class="font-display text-xl text-black">{project.year}</p>
        </div>
        <div class="bg-white p-6 border-l-4 border-gold">
          <p class="text-xs tracking-[0.2em] uppercase text-black/70 mb-1">Type</p>
          <p class="font-display text-xl text-black">{project.tagline || project.category}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-black">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-4">NEXT PROJECT</p>
      <h2 class="font-display text-3xl lg:text-4xl text-white mb-4">
        Let's Build Your Next Home
      </h2>
      <p class="text-white/60 text-sm mb-10 max-w-lg mx-auto">
        From concept sketches to final keys — your dream home is waiting.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/portfolio" class="btn-outline-gold">
          VIEW ALL PROJECTS
        </a>
        <a href="tel:+14036192702" class="btn-gold">
          CALL (403) 619-2702
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
