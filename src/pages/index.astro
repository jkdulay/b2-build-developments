---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { Home, MapPin, Award, Sparkles, ArrowRight } from '@lucide/astro';
---

<Layout>
  <Header />

  <!-- HERO: 50/50 Split -->
  <section class="min-h-screen flex">
    <!-- Left: Navy background + text -->
    <div class="w-full lg:w-1/2 bg-navy flex items-center relative overflow-hidden">
      <div class="max-w-xl mx-auto px-8 lg:px-16 py-40 relative z-10">
        <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl leading-[1.15] mb-6">
          <span class="text-white">LUXURY</span><br />
          <span class="text-gold">INNER-CITY</span><br />
          <span class="text-white">LIVING IN CALGARY</span>
        </h1>
        <p class="text-white/70 text-sm leading-relaxed mb-4 max-w-md">
          Modern design. Premium finishes.<br />Built for the way you live.
        </p>
        <div class="w-12 h-px bg-gold/50 mb-6"></div>
        <p class="text-white text-xs tracking-[0.3em] uppercase mb-1">STARTING AT</p>
        <p class="text-gold font-body text-4xl lg:text-5xl font-semibold tracking-wide mb-8">$1.8M</p>
        <div class="flex flex-nowrap gap-3">
          <a href="/portfolio" class="btn-gold text-xs px-4 py-2.5">
            REQUEST EARLY ACCESS
          </a>
          <a href="tel:+14037143780" class="btn-outline-gold border-white/30 text-white hover:bg-white hover:text-navy hover:border-white text-xs px-4 py-2.5">
            CALL: 403-714-3780
          </a>
        </div>
      </div>
      <!-- Decorative diagonal -->
      <div class="absolute -right-24 top-0 bottom-0 w-96 bg-gold/10 rotate-12 hidden lg:block"></div>
    </div>

    <!-- Right: Architectural image -->
    <div class="hidden lg:block lg:w-1/2 relative">
      <img
        src="https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=1200&q=85"
        alt="Luxury modern home exterior"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-navy/30 to-transparent"></div>
    </div>
  </section>

  <!-- FEATURE BAR: 4 columns -->
  <section class="bg-navy py-16">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
        <div class="text-center group">
          <div class="w-14 h-14 mx-auto mb-4 border border-gold flex items-center justify-center group-hover:bg-gold transition-all duration-300">
            <Home class="w-6 h-6 text-gold group-hover:text-white transition-colors" />
          </div>
          <p class="text-white/80 text-xs tracking-[0.2em] uppercase">Modern Architecture</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 mx-auto mb-4 border border-gold flex items-center justify-center group-hover:bg-gold transition-all duration-300">
            <Sparkles class="w-6 h-6 text-gold group-hover:text-white transition-colors" />
          </div>
          <p class="text-white/80 text-xs tracking-[0.2em] uppercase">Premium Finishes</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 mx-auto mb-4 border border-gold flex items-center justify-center group-hover:bg-gold transition-all duration-300">
            <MapPin class="w-6 h-6 text-gold group-hover:text-white transition-colors" />
          </div>
          <p class="text-white/80 text-xs tracking-[0.2em] uppercase">Prime Inner-City</p>
        </div>
        <div class="text-center group">
          <div class="w-14 h-14 mx-auto mb-4 border border-gold flex items-center justify-center group-hover:bg-gold transition-all duration-300">
            <Award class="w-6 h-6 text-gold group-hover:text-white transition-colors" />
          </div>
          <p class="text-white/80 text-xs tracking-[0.2em] uppercase">Luxury Living</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SUB-SECTION: Designed for how you live today -->
  <section class="py-20 lg:py-28 bg-offwhite">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Text left -->
        <div>
          <SectionHeading
            eyebrow="OUR PHILOSOPHY"
            title="Designed for how you live today"
            subtitle="This is more than a house. Every element has been carefully designed to balance modern aesthetics with practical living. Ideal for professionals, families, and investors looking to secure a premium inner-city property."
          />
          <div class="mt-8 flex flex-col gap-4">
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 bg-gold mt-2 shrink-0"></div>
              <p class="text-textgray text-sm leading-relaxed">Thoughtfully designed floor plans that maximize natural light and usable space.</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 bg-gold mt-2 shrink-0"></div>
              <p class="text-textgray text-sm leading-relaxed">Premium material selections chosen for beauty, durability, and low maintenance.</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-1.5 h-1.5 bg-gold mt-2 shrink-0"></div>
              <p class="text-textgray text-sm leading-relaxed">Smart storage solutions and flexible spaces that adapt to your lifestyle.</p>
            </div>
          </div>
          <a href="/about" class="btn-outline-navy mt-10 inline-flex">
            LEARN ABOUT US <ArrowRight class="w-4 h-4 ml-2" />
          </a>
        </div>

        <!-- Image right -->
        <div class="relative">
          <div class="overflow-hidden h-80 lg:h-[500px]">
            <img
              src="/photos/butler/butler-2.jpg"
              alt="Modern luxury kitchen interior"
              class="w-full h-full object-cover"
            />
          </div>
          <!-- Gold accent frame -->
          <div class="absolute -bottom-4 -right-4 w-full h-full border-2 border-gold -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOMES CTA BAND -->
  <section class="bg-navy py-20">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-4">CURRENTLY BUILDING</p>
      <h2 class="font-display text-3xl lg:text-4xl text-white mb-4">
        Explore Our Quick Possessions
      </h2>
      <p class="text-white/60 text-sm mb-10 max-w-xl mx-auto">
        Move-in ready homes in Calgary's most sought-after inner-city communities.
      </p>
      <a href="/possessions" class="btn-gold">
        VIEW AVAILABLE HOMES
      </a>
    </div>
  </section>

  <Footer />
</Layout>
