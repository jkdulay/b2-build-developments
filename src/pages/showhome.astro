---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { LayoutGrid, Star, BedDouble, Bath, Home } from '@lucide/astro';
---

<Layout
  title="The Brooklyn — B2 Build Ltd | 2220 8 Street NE, Calgary"
  description="The Brooklyn by B2 Build Ltd — a refined contemporary residence at 2220 8 Street NE, Calgary. Thoughtful design, premium finishes, and modern inner-city living."
>
  <Header />

  <!-- PAGE HERO -->
  <!-- TODO: Replace static image with autoplay/muted video slide per spec.
       Drive folder with hero video: https://drive.google.com/drive/u/8/folders/1WJjQYshknXM6lfETNJ-8c30OKrAsWPl1 -->
  <section class="relative h-[70vh] min-h-[480px] bg-black flex items-end overflow-hidden">
    <img
      src="/photos/butler/butler-1.jpg"
      alt="The Brooklyn — B2 Build showhome"
      class="absolute inset-0 w-full h-full object-cover opacity-60"
    />
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-12 pb-12 w-full">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-3">FEATURE HOME</p>
      <h1 class="font-display text-4xl lg:text-6xl text-white">
        THE BROOKLYN
      </h1>
      <p class="text-white/70 text-sm mt-2 uppercase tracking-[0.2em]">2220 8 Street NE &nbsp;|&nbsp; Calgary, Alberta &nbsp;|&nbsp; 2026</p>
    </div>
  </section>

  <!-- GALLERY: 1 large + 2 stacked -->
  <!-- TODO: Replace gallery with The Brooklyn photos. Spec:
       - Switch placement of front-exterior and kitchen photos
       - Keep the hero photo (large, left) as-is once Brooklyn assets are dropped in
       Placeholder arrangement below: front exterior (large, left) + kitchen (top right) + detail (bottom right) -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid lg:grid-cols-3 gap-4 h-auto lg:h-[540px]">
        <!-- Large hero left (front exterior) -->
        <div class="lg:col-span-2 h-64 lg:h-full overflow-hidden">
          <img
            src="/photos/butler/butler-1.jpg"
            alt="The Brooklyn front exterior"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
          />
        </div>
        <!-- Two stacked right -->
        <div class="grid grid-rows-2 gap-4 h-64 lg:h-full">
          <div class="overflow-hidden">
            <img
              src="/photos/butler/butler-2.jpg"
              alt="The Brooklyn kitchen"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
          <div class="overflow-hidden">
            <img
              src="/photos/butler/butler-3.jpg"
              alt="The Brooklyn detail"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            />
          </div>
        </div>
      </div>
      <p class="text-black/50 text-xs tracking-[0.15em] uppercase mt-4 text-center">
        Placeholder gallery — Brooklyn photos pending
      </p>
    </div>
  </section>

  <!-- SPECS: 5-icon row -->
  <section class="py-16 bg-white border-y border-black/10">
    <div class="max-w-5xl mx-auto px-6 lg:px-12">
      <SectionHeading
        eyebrow="HIGHLIGHTS"
        title="What Makes This Home Special"
        centered
      />
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 mt-10">
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 bg-white border border-black/10 flex items-center justify-center">
            <LayoutGrid class="w-6 h-6 text-gold" />
          </div>
          <p class="text-black text-xs tracking-[0.15em] uppercase font-medium">Modern Open Concept</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 bg-white border border-black/10 flex items-center justify-center">
            <Star class="w-6 h-6 text-gold" />
          </div>
          <p class="text-black text-xs tracking-[0.15em] uppercase font-medium">Elevated Finishes</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 bg-white border border-black/10 flex items-center justify-center">
            <BedDouble class="w-6 h-6 text-gold" />
          </div>
          <p class="text-black text-xs tracking-[0.15em] uppercase font-medium">Spacious Bedrooms</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-4 bg-white border border-black/10 flex items-center justify-center">
            <Bath class="w-6 h-6 text-gold" />
          </div>
          <p class="text-black text-xs tracking-[0.15em] uppercase font-medium">Luxurious Ensuites</p>
        </div>
        <div class="text-center col-span-2 sm:col-span-1">
          <div class="w-14 h-14 mx-auto mb-4 bg-white border border-black/10 flex items-center justify-center">
            <Home class="w-6 h-6 text-gold" />
          </div>
          <p class="text-black text-xs tracking-[0.15em] uppercase font-medium">Suite Potential</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECT DESCRIPTION -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 lg:px-12">
      <SectionHeading
        eyebrow="CUSTOM BUILD"
        title="The Brooklyn"
        subtitle="2220 8 Street NE · Calgary, Alberta · 2026"
        centered
      />
      <div class="space-y-5 text-black/75 text-base leading-relaxed">
        <p>
          The Brooklyn is a refined contemporary residence nestled within one of Calgary's most established golf course communities, where modern sophistication meets timeless warmth. Thoughtfully crafted with striking architectural details and rich Bastille flooring throughout, the home delivers an elevated yet inviting living experience.
        </p>
        <p>
          A sleek linear fireplace anchors the living space, while custom built-in seating adds warmth and functionality. The kitchen features premium cabinetry, integrated high-end appliances, and a clean modern aesthetic designed for both everyday living and effortless entertaining.
        </p>
        <p>
          Natural light floods through the arched windows, flowing seamlessly from the living room into the kitchen and dining space. Upstairs, two skylights overlook the serene interior, enhancing the home's open and connected atmosphere.
        </p>
        <p>
          Surrounded by mature landscapes and the character of Calgary's prestigious golf course community, The Brooklyn is a true expression of purposeful design and modern craftsmanship.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-black">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-gold text-xs tracking-[0.4em] uppercase mb-4">SCHEDULE A VIEWING</p>
      <h2 class="font-display text-3xl lg:text-4xl text-white mb-4">
        Ready to View The Brooklyn?
      </h2>
      <p class="text-white/60 text-sm mb-10 max-w-lg mx-auto">
        Reach out to schedule a private tour of our latest custom build in Winston Heights.
      </p>
      <a href="tel:+140****2702" class="btn-gold text-base px-8 py-4">
        CALL (403) 619-2702
      </a>
    </div>
  </section>

  <Footer />
</Layout>
