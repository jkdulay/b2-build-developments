---
import { Phone, Mail, Clock } from '@lucide/astro';
---

<footer id="contact" class="bg-black text-white">
  <!-- Contact Form + Info -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Left: Form -->
      <div>
        <h2 class="font-display text-3xl lg:text-4xl text-white mb-2 tracking-wide">Let's Build Together</h2>
        <p class="text-white/70 text-sm tracking-wide mb-10 uppercase">Ready to start your custom home journey?</p>

        <form id="contact-form" class="flex flex-col gap-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <input
              type="text"
              name="firstName"
              placeholder="FIRST NAME"
              required
              class="w-full bg-white/5 border border-white/20 px-4 py-3 text-xs tracking-[0.15em] uppercase placeholder-white/40 focus:outline-none focus:border-gold transition-colors"
            />
            <input
              type="text"
              name="lastName"
              placeholder="LAST NAME"
              required
              class="w-full bg-white/5 border border-white/20 px-4 py-3 text-xs tracking-[0.15em] uppercase placeholder-white/40 focus:outline-none focus:border-gold transition-colors"
            />
          </div>
          <input
            type="email"
            name="email"
            placeholder="EMAIL ADDRESS"
            required
            class="w-full bg-white/5 border border-white/20 px-4 py-3 text-xs tracking-[0.15em] uppercase placeholder-white/40 focus:outline-none focus:border-gold transition-colors"
          />
          <input
            type="tel"
            name="phone"
            placeholder="PHONE NUMBER"
            class="w-full bg-white/5 border border-white/20 px-4 py-3 text-xs tracking-[0.15em] uppercase placeholder-white/40 focus:outline-none focus:border-gold transition-colors"
          />
          <textarea
            name="message"
            rows="4"
            placeholder="TELL US ABOUT YOUR PROJECT"
            class="w-full bg-white/5 border border-white/20 px-4 py-3 text-xs tracking-[0.15em] uppercase placeholder-white/40 focus:outline-none focus:border-gold transition-colors resize-none"
          ></textarea>
          <button type="submit" class="btn-gold self-start mt-2">
            SEND MESSAGE
          </button>
        </form>
        <p id="form-success" class="hidden text-gold text-sm mt-4 tracking-wide">
          Thanks — your email client should have opened with your message ready to send to <strong>gurbinder@b2buildltd.com</strong>. If it didn&apos;t open, please email us directly.
        </p>
      </div>

      <!-- Right: Contact Info (no address / no map per current spec) -->
      <div class="lg:pt-20">
        <h3 class="font-display text-2xl text-white mb-8 tracking-wide">Get In Touch</h3>

        <div class="flex flex-col gap-6">
          <div class="flex items-start gap-3">
            <Phone class="w-4 h-4 text-gold mt-1 shrink-0" />
            <div>
              <p class="text-xs tracking-[0.15em] uppercase text-white/60 mb-1">PHONE</p>
              <p class="text-sm text-white">(403) 619-2702</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Mail class="w-4 h-4 text-gold mt-1 shrink-0" />
            <div>
              <p class="text-xs tracking-[0.15em] uppercase text-white/60 mb-1">EMAIL</p>
              <p class="text-sm text-white">admin@b2buildltd.com</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Clock class="w-4 h-4 text-gold mt-1 shrink-0" />
            <div>
              <p class="text-xs tracking-[0.15em] uppercase text-white/60 mb-1">SHOWINGS</p>
              <p class="text-sm text-white">By Appointment</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/40 tracking-[0.15em] uppercase">
        &copy; 2026 B2 BUILD LTD. ALL RIGHTS RESERVED.
      </p>
      <div class="flex items-center gap-6">
        <a href="/" class="text-xs text-white/40 tracking-[0.15em] uppercase hover:text-gold transition-colors">HOME</a>
        <a href="/about" class="text-xs text-white/40 tracking-[0.15em] uppercase hover:text-gold transition-colors">ABOUT</a>
        <a href="/services" class="text-xs text-white/40 tracking-[0.15em] uppercase hover:text-gold transition-colors">SERVICES</a>
        <a href="/portfolio" class="text-xs text-white/40 tracking-[0.15em] uppercase hover:text-gold transition-colors">PORTFOLIO</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // mailto-based form: opens the visitor's email client with a pre-filled message
  // to gurbinder@b2buildltd.com. Works on every device, no third-party service,
  // no DNS or SMTP credentials required.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  if (form) {
    form.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      const data = new FormData(form);
      const firstName = (data.get('firstName') || '').toString().trim();
      const lastName  = (data.get('lastName')  || '').toString().trim();
      const email     = (data.get('email')     || '').toString().trim();
      const phone     = (data.get('phone')     || '').toString().trim();
      const message   = (data.get('message')   || '').toString().trim();
      const name = [firstName, lastName].filter(Boolean).join(' ') || 'Website visitor';
      const subject = `B2 Build enquiry — ${name}`;
      const body = [
        `Name: ${name}`,
        `Email: ${email}`,
        `Phone: ${phone || '(not provided)'}`,
        '',
        'Project details:',
        message || '(no details provided)',
        '',
        '— Sent from b2builddevelopments.com contact form',
      ].join('\n');
      const mailto = `mailto:gurbinder@b2buildltd.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = mailto;
      if (success) success.classList.remove('hidden');
    });
  }
</script>
