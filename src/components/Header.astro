---
import { Menu, X } from '@lucide/astro';

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/about', label: 'ABOUT' },
  { href: '/showhome', label: 'SHOWHOME' },
  { href: '/services', label: 'SERVICES' },
  { href: '/portfolio', label: 'PORTFOLIO' },
  { href: '/possessions', label: 'POSSESSIONS' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="flex flex-col leading-none">
        <span class="font-display text-2xl text-white header-logo-text tracking-wider">B2 BUILD</span>
        <span class="text-gold text-[10px] tracking-[0.3em] uppercase mt-0.5 header-logo-sub">LTD.</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-xs tracking-[0.2em] uppercase font-body transition-colors duration-300 ${
              currentPath === link.href
                ? 'text-gold'
                : 'text-white hover:text-gold header-nav-text'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="hidden lg:flex items-center gap-6">
        <a href="#contact" class="btn-gold text-xs py-2.5 px-5">
          GET IN TOUCH
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-white p-2"
        aria-label="Toggle menu"
      >
        <Menu class="w-6 h-6 menu-open-icon" />
        <X class="w-6 h-6 hidden menu-close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-navy border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-xs tracking-[0.2em] uppercase font-body py-2 border-b border-white/10 transition-colors ${
            currentPath === link.href ? 'text-gold' : 'text-white hover:text-gold'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href="#contact" class="btn-gold text-center mt-4">
        GET IN TOUCH
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.querySelector('.menu-open-icon');
  const menuCloseIcon = document.querySelector('.menu-close-icon');

  // Scroll behavior
  const handleScroll = () => {
    if (window.scrollY > 60) {
      header?.classList.add('bg-navy', 'shadow-lg');
      document.querySelectorAll('.header-logo-text').forEach(el => el.classList.remove('text-white'));
      document.querySelectorAll('.header-logo-text').forEach(el => el.classList.add('text-white'));
      document.querySelectorAll('.header-nav-text').forEach(el => {
        el.classList.remove('text-white');
        el.classList.add('text-white/80');
      });
      document.querySelectorAll('.header-logo-sub').forEach(el => el.classList.add('text-gold'));
    } else {
      header?.classList.remove('bg-navy', 'shadow-lg');
      document.querySelectorAll('.header-logo-sub').forEach(el => el.classList.remove('text-gold'));
      document.querySelectorAll('.header-nav-text').forEach(el => {
        el.classList.remove('text-white/80');
        el.classList.add('text-white');
      });
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden');
    menuCloseIcon?.classList.toggle('hidden');
  });
</script>
