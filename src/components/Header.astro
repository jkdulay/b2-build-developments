---
import { Menu, X } from '@lucide/astro';

const navLinks = [
  { href: '/', label: 'HOME' },
  { href: '/about', label: 'ABOUT' },
  { href: '/showhome', label: 'FEATURE HOME' },
  { href: '/portfolio', label: 'PROPERTIES' },
  { href: '/services', label: 'SERVICES' },
];

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-white/95 backdrop-blur-sm shadow-lg border-b border-black/10">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex items-center justify-between h-24 lg:h-32">
      <!-- Logo (4× larger per spec, transparent bg) -->
      <a href="/" class="flex items-center gap-3">
        <img src="/logo.png" alt="B2 Build Ltd." class="h-20 lg:h-28 w-auto" />
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`text-xs tracking-[0.2em] uppercase font-body transition-colors duration-300 ${
              currentPath === link.href
                ? 'text-gold'
                : 'text-black hover:text-gold header-nav-text'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA + Mobile Toggle -->
      <div class="hidden lg:flex items-center gap-6">
        <a href="tel:+14036192702" class="btn-gold text-xs py-2.5 px-5">
          CALL NOW
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-black p-2"
        aria-label="Toggle menu"
      >
        <Menu class="w-6 h-6 menu-open-icon" />
        <X class="w-6 h-6 hidden menu-close-icon" />
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-white border-t border-black/10">
    <div class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`text-xs tracking-[0.2em] uppercase font-body py-2 border-b border-black/10 transition-colors ${
            currentPath === link.href ? 'text-gold' : 'text-black hover:text-gold'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href="tel:+14036192702" class="btn-gold text-center mt-4">
        CALL NOW
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpenIcon = document.querySelector('.menu-open-icon');
  const menuCloseIcon = document.querySelector('.menu-close-icon');

  // Scroll behavior
  const handleScroll = () => {
    if (window.scrollY > 60) {
      document.querySelectorAll('.header-nav-text').forEach(el => {
        el.classList.remove('text-black');
        el.classList.add('text-black/80');
      });
    } else {
      document.querySelectorAll('.header-nav-text').forEach(el => {
        el.classList.remove('text-black/80');
        el.classList.add('text-black');
      });
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu toggle
  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    menuOpenIcon?.classList.toggle('hidden');
    menuCloseIcon?.classList.toggle('hidden');
  });
</script>
