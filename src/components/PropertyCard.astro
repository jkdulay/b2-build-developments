---
export interface Props {
  name: string;
  price: string;
  sqft: string;
  beds?: string;
  baths?: string;
  imageUrl: string;
  location: string;
}
const { name, price, sqft, beds, baths, imageUrl, location } = Astro.props;
---

<div class="bg-white border border-navy/10 overflow-hidden group hover:border-gold transition-all duration-300">
  <!-- Image -->
  <div class="relative h-56 overflow-hidden">
    <img
      src={imageUrl}
      alt={name}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    <div class="absolute top-4 left-4 bg-gold text-white text-xs font-body font-medium tracking-[0.15em] uppercase px-4 py-2">
      {price}
    </div>
  </div>

  <!-- Info -->
  <div class="p-6">
    <p class="text-xs text-textgray tracking-[0.2em] uppercase mb-1">{location}</p>
    <h3 class="font-display text-xl text-navy mb-3">{name}</h3>
    <div class="flex items-center gap-4 text-xs text-navy/70 tracking-wide">
      <span>{sqft} SQ FT</span>
      {beds && <span>{beds} BED</span>}
      {baths && <span>{baths} BATH</span>}
    </div>
    <div class="mt-5">
      <a href="#" class="btn-outline-navy text-xs py-2 px-5">
        VIEW DETAILS
      </a>
    </div>
  </div>
</div>
