---
import type { ComponentType } from 'astro';
export interface Props {
  title: string;
  description: string;
  icon?: ComponentType;
  image?: string;
  alt?: string;
}
const { title, description, image, alt } = Astro.props;
---

<div class="bg-white border-t-4 border-gold overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
  {image && (
    <div class="overflow-hidden h-40">
      <img src={image} alt={alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
    </div>
  )}
  <div class="p-6">
    <h3 class="font-display text-xl text-navy mb-3 tracking-wide group-hover:text-gold transition-colors duration-300">
      {title}
    </h3>
    <p class="text-textgray text-sm leading-relaxed">
      {description}
    </p>
  </div>
</div>
