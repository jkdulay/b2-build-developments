---
import type { ComponentType } from 'astro';
export interface Props {
  title: string;
  description: string;
  icon?: ComponentType;
}
const { title, description } = Astro.props;
---

<div class="bg-white border-t-4 border-gold p-8 transition-all duration-300 hover:shadow-xl hover:-translate-y-1 group">
  <h3 class="font-display text-xl text-navy mb-3 tracking-wide group-hover:text-gold transition-colors duration-300">
    {title}
  </h3>
  <p class="text-textgray text-sm leading-relaxed">
    {description}
  </p>
</div>
